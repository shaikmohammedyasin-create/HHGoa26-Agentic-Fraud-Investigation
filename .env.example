# ============================================================
# Application
# ============================================================
APP_ENV=development
# development | benchmark | production
# production requires TigerGraph health = ok at startup

LOG_LEVEL=INFO

# ============================================================
# Demo mode (judges: leave DEMO_MODE=1 - no TigerGraph required)
# ============================================================
DEMO_MODE=1
# 0 = live mode (real TigerGraph, strict fail-closed behavior)
# 1 = demo mode: serves precomputed case results + synthetic data
#     without TigerGraph. Nemotron calls to Nebius Token Factory
#     stay live but are cache-protected and capped so judge traffic
#     cannot drain credits (see NEBIUS_DAILY_CALL_CAP below).

# ============================================================
# Nebius Token Factory (NVIDIA Nemotron models)
# ============================================================
# Used for the four analysis roles (pattern proposal, verification
# draft, analyst narrative + SAR draft, analyst Q&A). The policy
# engine always makes the final action decision; every LLM role has
# a deterministic fallback so an empty key degrades gracefully.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=
NEBIUS_MODEL_NANO=
NEBIUS_MODEL_SUPER=
NEBIUS_MODEL_ULTRA=
# Global daily call cap for demo-mode LLM usage (spend protection)
NEBIUS_DAILY_CALL_CAP=200

# ============================================================
# Optional web research key (not required to run the project)
# ============================================================
TAVILY_API_KEY=

# ============================================================
# Graph backend
# ============================================================
GRAPH_BACKEND=local
# local | tigergraph
# local uses a prepared SQLite graph store (data/prepared/investigation.db)

# ============================================================
# TigerGraph (required when GRAPH_BACKEND=tigergraph)
# Canonical names: TIGERGRAPH_* - the short TG_* names are also
# accepted by the backend.
# ============================================================
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=fraud_investigation
TIGERGRAPH_USERNAME=
TIGERGRAPH_PASSWORD=
TIGERGRAPH_SECRET=
# -- or use a token instead of secret/password:
TIGERGRAPH_TOKEN=
TIGERGRAPH_PORT=443
TIGERGRAPH_PROTOCOL=https

# ============================================================
# TigerGraph MCP (optional, enhances tool surface)
# ============================================================
MCP_URL=
# e.g. http://localhost:9000

# ============================================================
# Legacy LLM providers (summaries / SAR template layer)
# ============================================================
LLM_PROVIDER=none
# anthropic | openai | groq | none
# The Nemotron section above covers the analysis roles; these keys
# power the legacy summary/narrative provider and stay optional.

LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1

# ============================================================
# Data paths
# ============================================================
DATA_DIR=data
PREPARED_DB=data/prepared/investigation.db
APP_DB=data/app/app.db
CASES_DIR=cases

# ============================================================
# Investigation limits
# ============================================================
MAX_INVESTIGATION_STEPS=25
MAX_EVIDENCE_REQUESTS=3
FRAUD_PROB_STOP_HIGH=0.85
FRAUD_PROB_STOP_LOW=0.15
MIN_EVIDENCE_FOR_STOP=2

# ============================================================
# Agentic evidence loop
# ============================================================
# simulated     = agent generates documented synthetic responses (benchmark default)
# human_in_loop = agent pauses at MORE_EVIDENCE_REQUIRED and waits for
#                 POST /investigations/{id}/evidence (UI supplies the response)
EVIDENCE_REQUEST_MODE=simulated
# Minimum expected decision impact (0-1) for the agent to request evidence
MIN_EVIDENCE_INFO_VALUE=0.25
# Hard bound on reassessment rounds per investigation
MAX_INVESTIGATION_ROUNDS=3
