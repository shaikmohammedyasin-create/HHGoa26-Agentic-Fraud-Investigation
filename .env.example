# ============================================================
# Application
# ============================================================
APP_ENV=development
# development | benchmark | production
# production requires TigerGraph health = ok at startup

LOG_LEVEL=INFO

# ============================================================
# Graph backend
# ============================================================
GRAPH_BACKEND=local
# local | tigergraph
# local uses a prepared SQLite graph store (see docs/backend/DEVELOPMENT.md)

# ============================================================
# TigerGraph (required when GRAPH_BACKEND=tigergraph)
# ============================================================
TG_HOST=
TG_GRAPH=fraud_investigation
TG_USERNAME=
TG_PASSWORD=
TG_SECRET=
# -- or use a token instead of secret/password:
TG_TOKEN=
TG_PORT=443
TG_PROTOCOL=https

# ============================================================
# TigerGraph MCP (optional, enhances tool surface)
# ============================================================
MCP_URL=
# e.g. http://localhost:9000

# ============================================================
# LLM (optional – summaries and SAR narratives only)
# ============================================================
LLM_PROVIDER=anthropic
# anthropic | openai | none
# When none, the backend writes template-based summaries and narratives.

ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
# Use Haiku for cost control; upgrade to Sonnet/Opus for demo runs

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1

# ============================================================
# Data paths
# ============================================================
DATA_DIR=data
PREPARED_DB=data/prepared/investigation.db
APP_DB=data/app/app.db
CASES_DIR=cases

# ============================================================
# Investigation limits
# ============================================================
MAX_INVESTIGATION_STEPS=25
MAX_EVIDENCE_REQUESTS=3
FRAUD_PROB_STOP_HIGH=0.85
FRAUD_PROB_STOP_LOW=0.15
MIN_EVIDENCE_FOR_STOP=2
