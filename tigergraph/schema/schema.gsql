// ============================================================
// TigerGraph Schema for HHGOA Fraud Investigation
// Based on dataset: transactions.csv, identity.csv,
//   closed_cases_history.csv, case_pack.csv
// ============================================================

// ── Vertex types ─────────────────────────────────────────────

CREATE VERTEX Customer (
  PRIMARY_ID customer_id STRING,
  first_seen DATETIME,
  last_seen DATETIME
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Card (
  PRIMARY_ID card_id STRING,
  customer_id STRING,
  card4 STRING,          // visa, mastercard, etc.
  card6 STRING           // credit, debit
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX Transaction (
  PRIMARY_ID txn_id STRING,
  ts DATETIME,
  amount DOUBLE,
  product_cd STRING,
  channel STRING,        // online | in_person
  addr1 STRING,
  addr2 STRING,
  risk_score DOUBLE,
  p_email STRING,
  r_email STRING,
  customer_id STRING,    // denormalised so a Transaction vertex answers on its own
  card_id STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX DeviceProfile (
  PRIMARY_ID device_profile_id STRING,
  device_info STRING,
  os STRING,
  browser STRING,
  screen STRING,
  device_type STRING     // mobile | desktop
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX EmailDomain (
  PRIMARY_ID domain STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX BillingRegion (
  PRIMARY_ID region_code STRING,
  country_code STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

CREATE VERTEX ClosedCase (
  PRIMARY_ID case_id STRING,
  customer_id STRING,
  card_id STRING,
  opened_at DATETIME,
  closed_at DATETIME,
  outcome STRING,        // confirmed_fraud | cleared
  pattern STRING,
  exposure_usd DOUBLE,
  n_txns INT,
  report_filed BOOL,
  analyst_notes STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

// Investigation cases written by the agent
CREATE VERTEX InvestigationCase (
  PRIMARY_ID case_id STRING,
  trigger_type STRING,
  trigger_text STRING,
  opened_at DATETIME,
  status STRING,
  verdict STRING,
  fraud_probability DOUBLE,
  pattern STRING,
  exposure_usd DOUBLE,
  summary STRING
) WITH STATS="OUTDEGREE_BY_EDGETYPE"

// ── Edge types ───────────────────────────────────────────────

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card)
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY"
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile)
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain)
CREATE DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain)
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion)
CREATE DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction)  // ordered by ts within card

// Closed case edges
CREATE DIRECTED EDGE CC_INVOLVES (FROM ClosedCase, TO Transaction)
CREATE DIRECTED EDGE CC_ON_CARD (FROM ClosedCase, TO Card)
CREATE DIRECTED EDGE CC_CONNECTED_TO (FROM ClosedCase, TO Card)

// Investigation case edges
CREATE DIRECTED EDGE IC_INVOLVES (FROM InvestigationCase, TO Transaction)
CREATE DIRECTED EDGE IC_ON_CARD (FROM InvestigationCase, TO Card)
CREATE DIRECTED EDGE IC_FOR_CUSTOMER (FROM InvestigationCase, TO Customer)
CREATE DIRECTED EDGE IC_ON_DEVICE (FROM InvestigationCase, TO DeviceProfile)

// ── Graph ────────────────────────────────────────────────────

CREATE GRAPH fraud_investigation (
  Customer, Card, Transaction, DeviceProfile, EmailDomain,
  BillingRegion, ClosedCase, InvestigationCase,
  OWNS, MADE, MADE_BY, FROM_DEVICE, PURCHASER_EMAIL,
  RECIPIENT_EMAIL, BILLED_IN, NEXT_TXN,
  CC_INVOLVES, CC_ON_CARD, CC_CONNECTED_TO,
  IC_INVOLVES, IC_ON_CARD, IC_FOR_CUSTOMER, IC_ON_DEVICE
)
