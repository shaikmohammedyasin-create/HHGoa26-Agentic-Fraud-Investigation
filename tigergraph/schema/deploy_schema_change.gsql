// ============================================================
// TigerGraph 4.2.5 GSQL Schema Deployment for fraud_investigation
// Safely targets ONLY the fraud_investigation graph.
// Does NOT touch Transaction_Fraud or any other graph.
// ============================================================

USE GRAPH fraud_investigation

CREATE SCHEMA_CHANGE JOB deploy_hhgoa_schema FOR GRAPH fraud_investigation {
  // ── Vertex Types ─────────────────────────────────────────────

  ADD VERTEX Customer (
    PRIMARY_ID customer_id STRING,
    first_seen DATETIME,
    last_seen DATETIME
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Card (
    PRIMARY_ID card_id STRING,
    customer_id STRING,
    card4 STRING,
    card6 STRING
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX Transaction (
    PRIMARY_ID txn_id STRING,
    ts DATETIME,
    amount DOUBLE,
    product_cd STRING,
    channel STRING,
    addr1 STRING,
    addr2 STRING,
    risk_score DOUBLE,
    p_email STRING,
    r_email STRING,
    customer_id STRING,
    card_id STRING
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX DeviceProfile (
    PRIMARY_ID device_profile_id STRING,
    device_info STRING,
    os STRING,
    browser STRING,
    screen STRING,
    device_type STRING
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX EmailDomain (
    PRIMARY_ID domain STRING
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX BillingRegion (
    PRIMARY_ID region_code STRING,
    country_code STRING
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX ClosedCase (
    PRIMARY_ID case_id STRING,
    customer_id STRING,
    card_id STRING,
    opened_at DATETIME,
    closed_at DATETIME,
    outcome STRING,
    pattern STRING,
    exposure_usd DOUBLE,
    n_txns INT,
    report_filed BOOL,
    analyst_notes STRING
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  ADD VERTEX InvestigationCase (
    PRIMARY_ID case_id STRING,
    trigger_type STRING,
    trigger_text STRING,
    opened_at DATETIME,
    status STRING,
    verdict STRING,
    fraud_probability DOUBLE,
    pattern STRING,
    exposure_usd DOUBLE,
    summary STRING
  ) WITH STATS="OUTDEGREE_BY_EDGETYPE";

  // ── Edge Types ───────────────────────────────────────────────

  ADD DIRECTED EDGE OWNS (FROM Customer, TO Card);
  ADD DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY";
  ADD DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
  ADD DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
  ADD DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain);
  ADD DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
  ADD DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction);

  // ClosedCase edges
  ADD DIRECTED EDGE CC_INVOLVES (FROM ClosedCase, TO Transaction);
  ADD DIRECTED EDGE CC_ON_CARD (FROM ClosedCase, TO Card);
  ADD DIRECTED EDGE CC_CONNECTED_TO (FROM ClosedCase, TO Card);

  // InvestigationCase edges
  ADD DIRECTED EDGE IC_INVOLVES (FROM InvestigationCase, TO Transaction);
  ADD DIRECTED EDGE IC_ON_CARD (FROM InvestigationCase, TO Card);
  ADD DIRECTED EDGE IC_FOR_CUSTOMER (FROM InvestigationCase, TO Customer);
  ADD DIRECTED EDGE IC_ON_DEVICE (FROM InvestigationCase, TO DeviceProfile);
}

RUN SCHEMA_CHANGE JOB deploy_hhgoa_schema
DROP JOB deploy_hhgoa_schema
