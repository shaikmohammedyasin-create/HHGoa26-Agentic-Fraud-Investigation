// ============================================================
// Step 2: Deploy All 14 Edges to fraud_investigation
// Connects Customer, Card, Transaction, DeviceProfile,
// EmailDomain, BillingRegion, ClosedCase, InvestigationCase
// ============================================================

USE GRAPH fraud_investigation

CREATE SCHEMA_CHANGE JOB deploy_hhgoa_edges FOR GRAPH fraud_investigation {
  ADD DIRECTED EDGE OWNS (FROM Customer, TO Card);
  ADD DIRECTED EDGE MADE (FROM Card, TO Transaction) WITH REVERSE_EDGE="MADE_BY";
  ADD DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
  ADD DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
  ADD DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain);
  ADD DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
  ADD DIRECTED EDGE NEXT_TXN (FROM Transaction, TO Transaction);

  // ClosedCase edges
  ADD DIRECTED EDGE CC_INVOLVES (FROM ClosedCase, TO Transaction);
  ADD DIRECTED EDGE CC_ON_CARD (FROM ClosedCase, TO Card);
  ADD DIRECTED EDGE CC_CONNECTED_TO (FROM ClosedCase, TO Card);

  // InvestigationCase edges
  ADD DIRECTED EDGE IC_INVOLVES (FROM InvestigationCase, TO Transaction);
  ADD DIRECTED EDGE IC_ON_CARD (FROM InvestigationCase, TO Card);
  ADD DIRECTED EDGE IC_FOR_CUSTOMER (FROM InvestigationCase, TO Customer);
  ADD DIRECTED EDGE IC_ON_DEVICE (FROM InvestigationCase, TO DeviceProfile);
}

RUN SCHEMA_CHANGE JOB deploy_hhgoa_edges
DROP JOB deploy_hhgoa_edges
