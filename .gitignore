# Round-provided dataset files - root copies are local-only, never published.
# The synthetic replacements (data/synthetic/) ARE published and must stay
# un-ignored, hence the root anchors and the negation below.
/transactions.csv
/identity.csv
/closed_cases_history.csv
/case_pack.csv
data/*
!data/README.md
!data/synthetic/

# Environment, secrets and keys
.env
.env.local
*.pem
*.key

# System & IDE files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
scratch/
*.webp

# Local artifacts (preserve benchmark data)
artifacts/*.md
!artifacts/benchmark/**

# sentinel-ui (vendored Next.js console)
